<?xml version="1.0" encoding="utf-8"?>
<!-- v27: terminal workspace card — rounded 12dp outline around the
     wallpaper + TerminalView. The solid is transparent (the wallpaper
     ImageView behind the TerminalView is the visible surface); the
     stroke is the subtle reference border. The background drawable
     also supplies the FrameLayout's outline, so clipToOutline clips
     the wallpaper and terminal to the same rounded rect. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="1dp"
        android:color="@color/nobi_ds_outline" />
    <corners android:radius="12dp" />
</shape>
