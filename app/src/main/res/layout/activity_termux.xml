<com.termux.app.terminal.TermuxActivityRootView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_termux_root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <!-- v24 w48: Material 3-style TopAppBar (spec 2A). 56dp, nav icon opens
         the drawer, title is the app name, subtitle is the current session
         (set from code in updateNobiToolbarSubtitle). -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/nobi_toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nobi_ds_toolbar_height"
        android:background="@color/nobi_ds_app_bg"
        app:navigationIcon="@drawable/ic_nobi_menu"
        app:title="@string/application_name"
        app:titleTextColor="@color/nobi_ds_text_primary"
        app:subtitleTextColor="@color/nobi_ds_text_secondary" />

    <LinearLayout
        android:id="@+id/nobi_tabs_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nobi_ds_tabs_bar_height"
        android:orientation="horizontal"
        android:background="@color/nobi_ds_surface">

        <HorizontalScrollView
            android:id="@+id/nobi_tabs_scroll_view"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/nobi_tabs_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/nobi_tab_add"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="+"
            android:textSize="22sp"
            android:textColor="@color/nobi_ds_accent"
            android:contentDescription="New session" />
    </LinearLayout>

    <!-- v6 (9): active session's note, shown under the tabs bar when set. -->
    <TextView
        android:id="@+id/nobi_tab_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="2dp"
        android:paddingBottom="4dp"
        android:background="@color/nobi_ds_surface"
        android:textColor="@color/nobi_ds_text_secondary"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <RelativeLayout
        android:id="@+id/activity_termux_root_relative_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginVertical="0dp"
        android:orientation="vertical">

        <androidx.drawerlayout.widget.DrawerLayout
            android:id="@+id/drawer_layout"
            android:layout_width="match_parent"
            android:layout_alignParentTop="true"
            android:layout_above="@+id/terminal_toolbar_view_pager"
            android:layout_height="match_parent">

            <com.termux.view.TerminalView
                android:id="@+id/terminal_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="@dimen/nobi_ds_terminal_padding"
                android:defaultFocusHighlightEnabled="false"
                android:focusableInTouchMode="true"
                android:scrollbarThumbVertical="@drawable/terminal_scroll_shape"
                android:scrollbars="vertical"
                tools:ignore="UnusedAttribute" />

            <LinearLayout
                android:id="@+id/left_drawer"
                android:layout_width="@dimen/nobi_ds_drawer_width"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:choiceMode="singleChoice"
                android:divider="@android:color/transparent"
                android:dividerHeight="0dp"
                android:descendantFocusability="blocksDescendants"
                android:orientation="vertical"
                android:background="@drawable/nobi_drawer_background">

                <!-- v24 w49: compact M3 drawer header (spec 3): icon +
                     app name + "Developer workspace" + real version.
                     Replaces the v5 settings-gear row (gone since v5,
                     still wired — the wiring is removed in code).
                     Icon is ic_foreground (transparent N mark), NOT
                     nobi_app_icon (that vector has a baked bg rect). -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_foreground" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/application_name"
                            android:textColor="@color/nobi_ds_drawer_text"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/nobi_drawer_subtitle"
                            android:textColor="@color/nobi_ds_drawer_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/nobi_drawer_version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/nobi_ds_drawer_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/nobi_drawer_menu"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingTop="0dp">

                    <LinearLayout
                        android:id="@+id/nobi_menu_new_session"
                        style="@style/NobiDsDrawerRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_new_session"
                            app:tint="@color/nobi_cyan" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="@string/nobi_menu_new_session"
                            android:textColor="?attr/termuxActivityDrawerImageTint"
                            android:textSize="15sp" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/nobi_menu_new_window"
                        style="@style/NobiDsDrawerRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_new_window"
                            app:tint="@color/nobi_cyan" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="@string/nobi_menu_new_window"
                            android:textColor="?attr/termuxActivityDrawerImageTint"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/nobi_menu_nobicode"
                        style="@style/NobiDsDrawerRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_nobi_code"
                            app:tint="@color/nobi_cyan" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="@string/nobi_menu_nobicode"
                            android:textColor="?attr/termuxActivityDrawerImageTint"
                            android:textSize="15sp" />
                    </LinearLayout>


                    <!-- v6 batch 1-16: terminal tools. -->
                    <LinearLayout
                        android:id="@+id/nobi_menu_quick_commands"
                        style="@style/NobiDsDrawerRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_nobi_terminal"
                            app:tint="@color/nobi_cyan" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="@string/nobi_menu_quick_commands"
                            android:textColor="?attr/termuxActivityDrawerImageTint"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/nobi_menu_find"
                        style="@style/NobiDsDrawerRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_nobi_search"
                            app:tint="@color/nobi_cyan" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="@string/nobi_menu_find"
                            android:textColor="?attr/termuxActivityDrawerImageTint"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/nobi_menu_server"
                        style="@style/NobiDsDrawerRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_nobi_server"
                            app:tint="@color/nobi_cyan" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="@string/nobi_menu_server"
                            android:textColor="?attr/termuxActivityDrawerImageTint"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/nobi_menu_session_tools"
                        style="@style/NobiDsDrawerRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_nobi_tools"
                            app:tint="@color/nobi_cyan" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="@string/nobi_menu_session_tools"
                            android:textColor="?attr/termuxActivityDrawerImageTint"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <!-- v7 (58): terminal output → editor. -->
                    <LinearLayout
                        android:id="@+id/nobi_menu_output_editor"
                        style="@style/NobiDsDrawerRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_nobi_terminal"
                            app:tint="@color/nobi_cyan" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="@string/nobi_menu_output_editor"
                            android:textColor="?attr/termuxActivityDrawerImageTint"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/nobi_menu_permissions"
                        style="@style/NobiDsDrawerRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:src="@drawable/nobi_ic_shield"
                            app:tint="@color/nobi_cyan" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="@string/nobi_menu_permissions"
                            android:textColor="?attr/termuxActivityDrawerImageTint"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/nobi_menu_settings"
                        style="@style/NobiDsDrawerRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_settings"
                            app:tint="@color/nobi_cyan" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="@string/nobi_menu_settings"
                            android:textColor="?attr/termuxActivityDrawerImageTint"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/nobi_menu_exit"
                        style="@style/NobiDsDrawerRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_nobi_exit"
                            app:tint="@color/nobi_cyan" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="@string/nobi_menu_exit"
                            android:textColor="?attr/termuxActivityDrawerImageTint"
                            android:textSize="15sp" />
                    </LinearLayout>

                </LinearLayout>

                <ListView
                    android:id="@+id/terminal_sessions_list"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_gravity="top"
                    android:layout_weight="1"
                    android:choiceMode="none"
                    android:longClickable="true" />

                <LinearLayout
                    android:id="@+id/drawer_buttons"
                    style="?android:attr/buttonBarStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/toggle_keyboard_button"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/action_toggle_soft_keyboard" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/new_session_button"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/action_new_session" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/new_window_button"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:visibility="gone"
                        android:text="@string/action_new_window" />
                </LinearLayout>
            </LinearLayout>

        </androidx.drawerlayout.widget.DrawerLayout>

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/terminal_toolbar_view_pager"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/nobi_ds_extra_key_row_height"
            android:background="@color/nobi_ds_terminal_bg"
            android:layout_alignParentBottom="true" />

    </RelativeLayout>

    <!-- v7 (81): optional bottom navigation bar (drawer alternative). -->
    <LinearLayout
        android:id="@+id/nobi_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/nobi_ds_surface"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/nobi_bottom_tabs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Tabs"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/nobi_bottom_editor"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Editor"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/nobi_bottom_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Settings"
            android:textSize="14sp" />
    </LinearLayout>

    <View
        android:id="@+id/activity_termux_bottom_space_view"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/transparent" />

</com.termux.app.terminal.TermuxActivityRootView>
