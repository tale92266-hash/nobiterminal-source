<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- v21 w31: night twins of the mode-resolved Nobi tokens.
         v26: the spec palette replaces the v25 Chrome greys. The v25
         retune was deliberately boring/neutral; Sam's own v26 spec
         restores the deep-navy professional look, so the dark tokens
         are now the spec values verbatim:
         - app bg #070B18, terminal bg #050A19, toolbar #080D1A
         - surface #101827, elevated #151F30, selected tab #12345C
         - primary blue #168BFF (accent in both modes now, was #8AB4F8),
           secondary cyan #00D6E8 lives ONLY in terminal branding
           (welcome wordmark + cursor), never in general controls
         - text #F2F5FC / #AAB6C8, border #26354A
         - success/warning/error stay the muted Google dark tones
         - drawer stays the charcoal #202124 in both modes (v25)
         nobi_navy/nobi_periwinkle still resolve from values/ (brand navy
         survives only in the launcher icon + splash, never in-app). -->
    <color name="nobi_body_surface">#FF202124</color>
    <color name="nobi_secondary_text">#FF9AA0A6</color>
    <!-- v26: night accent = spec primary blue (was #8AB4F8 in v25). -->
    <color name="nobi_cyan">#FF168BFF</color>
    <color name="nobi_cyan_highlight">#66168BFF</color>
    <!-- v26: design-system tokens, DARK mode values (spec palette). -->
    <color name="nobi_ds_app_bg">#FF070B18</color>
    <color name="nobi_ds_terminal_bg">#FF050A19</color>
    <color name="nobi_ds_toolbar_bg">#FF080D1A</color>
    <color name="nobi_ds_surface">#FF101827</color>
    <color name="nobi_ds_elevated">#FF151F30</color>
    <color name="nobi_ds_selected">#FF12345C</color>
    <color name="nobi_ds_accent">@color/nobi_cyan</color>
    <color name="nobi_ds_text_primary">#FFF2F5FC</color>
    <color name="nobi_ds_text_secondary">#FFAAB6C8</color>
    <color name="nobi_ds_text_tertiary">#FF64748B</color>
    <color name="nobi_ds_outline">#FF26354A</color>
    <!-- v27: keycap + active-tab tokens. ROOT CAUSE of the flat keys:
         the keycap fill was nobi_ds_elevated (#151F30) and the outline
         #26354A on the #050A19 bar — ~1.3:1 contrast, invisible. These
         dedicated values are visibly lighter than the bar but still dark
         navy (fill) with a restrained blue-violet outline, so the caps
         read as caps. Active tab gradient top (bright end). -->
    <color name="nobi_ds_keycap_bg">#FF1B2A45</color>
    <color name="nobi_ds_keycap_outline">#FF3E6FB5</color>
    <color name="nobi_ds_keycap_active_outline">#FF168BFF</color>
    <color name="nobi_ds_tab_active_top">#FF1B5FC4</color>
    <color name="nobi_ds_purple">#FF7545D9</color>
    <color name="nobi_ds_success">#FF81C995</color>
    <color name="nobi_ds_warning">#FFFDD663</color>
    <color name="nobi_ds_error">#FFF28B82</color>
    <color name="nobi_ds_drawer_bg">#FF202124</color>
    <color name="nobi_ds_drawer_text">#FFE8EAED</color>
    <color name="nobi_ds_drawer_text_secondary">#FF9AA0A6</color>
</resources>
