<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <Preference
        app:icon="@drawable/nobi_pref_gear"
        app:key="termux"
        app:title="@string/termux_preferences_title"
        app:summary="@string/termux_preferences_summary"
        app:fragment="com.termux.app.fragments.settings.TermuxPreferencesFragment"/>

    <Preference
        app:icon="@drawable/nobi_pref_server"
        app:key="termux_api"
        app:title="@string/termux_api_preferences_title"
        app:summary="@string/termux_api_preferences_summary"
        app:isPreferenceVisible="false"
        app:fragment="com.termux.app.fragments.settings.TermuxAPIPreferencesFragment"/>

    <Preference
        app:icon="@drawable/nobi_pref_window"
        app:key="termux_float"
        app:title="@string/termux_float_preferences_title"
        app:summary="@string/termux_float_preferences_summary"
        app:isPreferenceVisible="false"
        app:fragment="com.termux.app.fragments.settings.TermuxFloatPreferencesFragment"/>

    <Preference
        app:icon="@drawable/nobi_pref_sliders"
        app:key="termux_tasker"
        app:title="@string/termux_tasker_preferences_title"
        app:summary="@string/termux_tasker_preferences_summary"
        app:isPreferenceVisible="false"
        app:fragment="com.termux.app.fragments.settings.TermuxTaskerPreferencesFragment"/>

    <Preference
        app:icon="@drawable/nobi_pref_grid"
        app:key="termux_widget"
        app:title="@string/termux_widget_preferences_title"
        app:summary="@string/termux_widget_preferences_summary"
        app:isPreferenceVisible="false"
        app:fragment="com.termux.app.fragments.settings.TermuxWidgetPreferencesFragment"/>

    <Preference
        app:icon="@drawable/nobi_pref_info"
        app:key="about"
        app:title="@string/about_preference_title"
        app:persistent="false"/>
    <!-- app:layout="@layout/preference_markdown_text" -->

    <Preference
        app:icon="@drawable/nobi_pref_share"
        app:key="donate"
        app:title="@string/donate_preference_title"
        app:persistent="false"
        app:isPreferenceVisible="false"/>

    <PreferenceCategory
        app:key="nobi_terminal"
        app:title="@string/nobi_settings_category_title">

        <Preference
            app:icon="@drawable/nobi_pref_copy"
            app:key="nobi_backup"
            app:title="@string/nobi_backup_preference_title"
            app:summary="@string/nobi_backup_preference_summary"
            app:persistent="false"/>

        <Preference
            app:icon="@drawable/nobi_pref_download"
            app:key="nobi_restore"
            app:title="@string/nobi_restore_preference_title"
            app:summary="@string/nobi_restore_preference_summary"
            app:persistent="false"/>

        <Preference
            app:icon="@drawable/nobi_pref_code"
            app:key="nobi_dev_setup"
            app:title="@string/nobi_dev_setup_preference_title"
            app:summary="@string/nobi_dev_setup_preference_summary"
            app:persistent="false"/>

        <Preference
            app:icon="@drawable/nobi_pref_theme"
            app:key="nobi_theme"
            app:title="@string/nobi_theme_preference_title"
            app:summary="@string/nobi_theme_preference_summary"
            app:fragment="com.termux.app.fragments.settings.nobi.ThemePreferencesFragment"/>

        <Preference
            app:icon="@drawable/nobi_pref_keyboard"
            app:key="nobi_extra_keys"
            app:title="@string/nobi_extra_keys_preference_title"
            app:summary="@string/nobi_extra_keys_preference_summary"
            app:fragment="com.termux.app.fragments.settings.nobi.ExtraKeysPreferencesFragment"/>

        <CheckBoxPreference
            app:icon="@drawable/nobi_pref_power"
            app:key="nobi_wake_lock"
            app:title="@string/nobi_wake_lock_preference_title"
            app:summary="@string/nobi_wake_lock_preference_summary"
            app:defaultValue="false"/>

        <Preference
            app:icon="@drawable/nobi_pref_lock"
            app:key="nobi_app_lock"
            app:title="@string/nobi_app_lock_preference_title"
            app:summary="@string/nobi_app_lock_preference_summary"
            app:persistent="false"/>

        <CheckBoxPreference
            app:icon="@drawable/nobi_pref_list"
            app:key="nobi_startup_picker"
            app:title="@string/nobi_startup_picker_preference_title"
            app:summary="@string/nobi_startup_picker_preference_summary"
            app:defaultValue="true"/>

        <CheckBoxPreference
            app:icon="@drawable/nobi_pref_play"
            app:key="nobi_animated_intro"
            app:title="@string/nobi_animated_intro_preference_title"
            app:summary="@string/nobi_animated_intro_preference_summary"
            app:defaultValue="true"/>

        <ListPreference
            app:icon="@drawable/nobi_pref_terminal"
            app:key="nobi_launcher_icon"
            app:title="@string/nobi_launcher_icon_preference_title"
            app:summary="@string/nobi_launcher_icon_preference_summary"
            app:entries="@array/nobi_launcher_icon_entries"
            app:entryValues="@array/nobi_launcher_icon_values"
            app:defaultValue="default"/>

    </PreferenceCategory>

</PreferenceScreen>
