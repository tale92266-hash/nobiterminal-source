<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- NobiTerminal brand navy, used as launcher icon and splash background. -->
    <color name="nobi_icon_background">#070B1F</color>
    <color name="nobi_splash_background">#070B1F</color>
    <!-- v9: drawer + keys-bar navy, same as the tabs bar (#FF0A0F24). -->
    <color name="nobi_navy">#FF0A0F24</color>
    <!-- v25: brand accent is a muted professional blue now, not neon
         cyan. Day #1A73E8 = the blue real Google apps use in light mode;
         the night twin (#8AB4F8) lives in values-night/colors.xml, so
         nobi_cyan / nobi_ds_accent are mode-resolved. The terminal
         cursor default 0xff22d3ee in TerminalColorScheme is a separate
         hardcoded constant and is untouched. -->
    <color name="nobi_cyan">#FF1A73E8</color>
    <color name="nobi_key_pressed">#FF1E2C55</color>
    <!-- v21 w30/w31: periwinkle secondary text for dark surfaces (never grey). -->
    <color name="nobi_periwinkle">#FF9AA5D9</color>
    <!-- v21 w31: mode-resolved body/secondary tokens (night twins live in values-night/colors.xml). -->
    <color name="nobi_body_surface">#FFF4F6FC</color>
    <color name="nobi_secondary_text">#FF475569</color>
    <!-- v21 w38: 40% accent selection highlight for the terminal text-input bar. -->
    <color name="nobi_cyan_highlight">#661A73E8</color>
    <!-- v21 w39: scrollbar thumb tint, >=3:1 on black (5.49:1) and white (3.83:1). -->
    <color name="nobi_scroll_thumb">#FF6B7FC7</color>
    <!-- v24 w47: design-system tokens, LIGHT mode values (night twins in
         values-night/colors.xml). v25: the dark palette was retuned from
         the v24 navy+cyan "AI app" look to neutral greys + muted blue
         (see the night file for the reasoning); light values stay the
         same restrained neutrals, except the drawer — it is charcoal in
         BOTH modes now (v21 w36's navy slab is gone), with light text. -->
    <color name="nobi_ds_app_bg">#FFF4F6FC</color>
    <color name="nobi_ds_terminal_bg">#FFF8FAFC</color>
    <color name="nobi_ds_surface">#FFFFFFFF</color>
    <color name="nobi_ds_elevated">#FFF1F5F9</color>
    <color name="nobi_ds_selected">#FFE0F2FE</color>
    <color name="nobi_ds_accent">@color/nobi_cyan</color>
    <color name="nobi_ds_text_primary">#FF0F172A</color>
    <color name="nobi_ds_text_secondary">#FF475569</color>
    <color name="nobi_ds_text_tertiary">#FF94A3B8</color>
    <color name="nobi_ds_outline">#FFE2E8F0</color>
    <color name="nobi_ds_success">#FF166534</color>
    <color name="nobi_ds_warning">#FF92400E</color>
    <color name="nobi_ds_error">#FFB91C1C</color>
    <color name="nobi_ds_drawer_bg">#FF202124</color>
    <color name="nobi_ds_drawer_text">#FFE8EAED</color>
    <color name="nobi_ds_drawer_text_secondary">#FF9AA0A6</color>
</resources>
