<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
     https://material.io/develop/android/theming/dark
    -->

    <!-- TermuxApp Light DarkActionBar theme. -->
    <style name="Theme.TermuxApp.Light.DarkActionBar" parent="Theme.BaseActivity.Light.DarkActionBar"/>
    <!-- TermuxApp Light NoActionBar theme. -->
    <style name="Theme.TermuxApp.Light.NoActionBar" parent="Theme.BaseActivity.Light.NoActionBar"/>

    <!-- TermuxApp DayNight DarkActionBar theme. -->
    <style name="Theme.TermuxApp.DayNight.DarkActionBar" parent="Theme.BaseActivity.DayNight.DarkActionBar"/>
    <!-- TermuxApp DayNight NoActionBar theme. -->
    <style name="Theme.TermuxApp.DayNight.NoActionBar" parent="Theme.BaseActivity.DayNight.NoActionBar"/>

    <!-- v17: Settings-only identity theme. Upstream BaseActivity paints the
         v17: Settings toolbar/status bar bright red (colorPrimary red_400
         v17: #FF0000, variant red_800 #C4001D) in BOTH modes, which clashes
         v17: with the Nobi navy+cyan identity. This override is used ONLY by
         v17: SettingsActivity (manifest); other activities keep the shared
         v17: theme untouched. Same navy in both modes: the toolbar is brand
         v17: chrome, not body, and white title text works on navy day+night.
         v17: w16 light/dark body follow is untouched (delegate night mode). -->
    <style name="Theme.NobiSettings.DayNight" parent="Theme.TermuxApp.DayNight.NoActionBar">
        <!-- Drawer/tabs navy (app colors.xml): toolbar + status bar + any
             primary-tinted control in Settings. -->
        <item name="colorPrimary">@color/nobi_navy</item>
        <item name="colorPrimaryVariant">@color/nobi_navy</item>
        <item name="colorPrimaryDark">@color/nobi_navy</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">@color/nobi_navy</item>
        <!-- v21 w30: Settings controls cyan; unchecked-control outline navy (day twin). -->
        <item name="colorSecondary">@color/nobi_cyan</item>
        <item name="colorControlActivated">@color/nobi_cyan</item>
        <item name="colorControlNormal">@color/nobi_navy</item>
        <!-- v21 w31: navy-tinted body + Nobi-hue secondary text. The v16 luminance-follow
             rule is untouched: SettingsActivity still picks day/night via setLocalNightMode,
             which selects this twin vs the values-night twin below. -->
        <item name="android:windowBackground">@color/nobi_body_surface</item>
        <item name="android:colorBackground">@color/nobi_body_surface</item>
        <item name="colorSurface">@color/nobi_body_surface</item>
        <item name="android:textColorSecondary">@color/nobi_secondary_text</item>
    </style>

    <!-- v21 w41: Report-only identity theme (v17 Settings pattern). ReportActivity
         uses the shared partial_primary_toolbar whose background is colorPrimaryDark,
         so navy primary items give it a Settings-like navy toolbar + white title in
         both modes. TOOLBAR ONLY: markdown body colors/layouts are untouched. -->
    <style name="Theme.NobiReport.DayNight" parent="Theme.TermuxApp.DayNight.NoActionBar">
        <item name="colorPrimary">@color/nobi_navy</item>
        <item name="colorPrimaryVariant">@color/nobi_navy</item>
        <item name="colorPrimaryDark">@color/nobi_navy</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">@color/nobi_navy</item>
        <item name="colorSecondary">@color/nobi_cyan</item>
        <item name="colorControlActivated">@color/nobi_cyan</item>
        <!-- v22 w45: Nobi-tinted body + Nobi-hue secondary text (w31 tokens).
             Day-mode links keep the inherited blue (#0969DA, 4.81:1 on the day
             body): cyan links fail contrast in day mode (1.67:1), so cyan links
             live only in the values-night twin of this style. -->
        <item name="android:windowBackground">@color/nobi_body_surface</item>
        <item name="android:colorBackground">@color/nobi_body_surface</item>
        <item name="colorSurface">@color/nobi_body_surface</item>
        <item name="android:textColorSecondary">@color/nobi_secondary_text</item>
    </style>


    <!-- v21 w42: Help-only identity theme. HelpActivity has no layout toolbar: it
         uses the framework ActionBar from this DarkActionBar parent, so navy primary
         items give it a navy bar + white title in both modes. WebView content (the
         Termux wiki site) is NOT themeable and is untouched; colorAccent cyan tints
         the loading ProgressBar (also pinned explicitly in code). -->
    <style name="Theme.NobiHelp.DayNight" parent="Theme.TermuxApp.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/nobi_navy</item>
        <item name="colorPrimaryVariant">@color/nobi_navy</item>
        <item name="colorPrimaryDark">@color/nobi_navy</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">@color/nobi_navy</item>
        <item name="colorSecondary">@color/nobi_cyan</item>
        <item name="colorControlActivated">@color/nobi_cyan</item>
        <item name="android:colorAccent">@color/nobi_cyan</item>
    </style>

    <!-- TermuxActivity DayNight NoActionBar theme. -->
    <style name="Theme.TermuxActivity.DayNight.NoActionBar" parent="Theme.TermuxApp.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <!-- v21 w37: terminal chrome accents cyan, primary black -> navy. -->
        <item name="colorPrimary">@color/nobi_navy</item>
        <item name="colorPrimaryVariant">@color/nobi_navy</item>
        <item name="colorSecondary">@color/nobi_cyan</item>
        <item name="colorControlActivated">@color/nobi_cyan</item>

        <item name="android:windowBackground">@color/black</item>

        <!-- Avoid action mode toolbar pushing down terminal content when
             selecting text on pre-6.0 (non-floating toolbar). -->
        <item name="android:windowActionModeOverlay">true</item>

        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>

        <!-- https://developer.android.com/training/tv/start/start.html#transition-color -->
        <item name="android:windowAllowReturnTransitionOverlap">true</item>
        <item name="android:windowAllowEnterTransitionOverlap">true</item>

        <!-- Left drawer. -->
        <item name="buttonBarButtonStyle">@style/TermuxActivity.Drawer.ButtonBarStyle.Light</item>
        <!-- v21 w36: drawer navy in BOTH modes (night twin already navy/white). -->
        <item name="termuxActivityDrawerBackground">@color/nobi_navy</item>
        <item name="termuxActivityDrawerImageTint">@color/white</item>

        <!-- Extra keys colors. -->
        <item name="extraKeysButtonTextColor">@color/white</item>
        <item name="extraKeysButtonActiveTextColor">@color/nobi_cyan</item>
        <item name="extraKeysButtonBackgroundColor">@color/nobi_navy</item>
        <item name="extraKeysButtonActiveBackgroundColor">@color/nobi_key_pressed</item>
    </style>

    <!-- NobiTerminal launch theme: branded splash window background, replaced
         as soon as the terminal activity applies its own styling. -->
    <style name="Theme.NobiTerminal.Launch" parent="Theme.TermuxActivity.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/nobi_splash_background</item>
    </style>

</resources>
